{
  "$schema": "https://mintlify.com/docs.json",
  "name": "GoAkt",
  "description": "Distributed actor framework for Go, inspired by Erlang and Akka. Build reactive and distributed systems with typed actor messages.",
  "theme": "mint",
  "seo": { "metatags": { "canonical": "https://docs.goakt.dev" } },
  "colors": { "primary": "#2563EB", "light": "#3B82F6", "dark": "#1D4ED8" },
  "favicon": "/assets/goakt-icon.png",
  "logo": {
    "light": "/assets/goakt-logo-light.svg",
    "dark": "/assets/goakt-logo-dark.svg",
    "href": "https://docs.goakt.dev"
  },
  "background": { "decoration": "gradient" },
  "fonts": {
    "heading": { "family": "Geist" },
    "body": { "family": "Geist" }
  },
  "appearance": { "default": "system" },
  "navbar": {
    "links": [
      {
        "label": "Reference",
        "href": "https://pkg.go.dev/github.com/tochemey/goakt/v4"
      },
      { "label": "GitHub", "href": "https://github.com/tochemey/goakt" }
    ]
  },
  "footer": { "socials": { "github": "https://github.com/tochemey/goakt" } },
  "styling": {
    "codeblocks": { "theme": { "light": "github-light", "dark": "dracula" } }
  },
  "redirects": [
    {
      "source": "/clustering/standalone",
      "destination": "/clustering/overview"
    },
    {
      "source": "/clustering/clustered",
      "destination": "/clustering/overview"
    },
    {
      "source": "/advanced/reliable-delivery",
      "destination": "/clustering/reliable-delivery/point-to-point"
    },
    {
      "source": "/architecture/context-pool",
      "destination": "/architecture/context-pools"
    }
  ],
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "/index",
          "/getting-started/installation",
          "/getting-started/migration-v3"
        ],
        "icon": "rocket"
      },
      {
        "group": "Actor",
        "pages": [
          "/actor/first-actor",
          "/actor/actor-model",
          "/actor/actor-system",
          "/actor/pid",
          "/actor/messaging",
          "/actor/mailboxes",
          "/actor/lifecycle",
          "/actor/supervision",
          "/actor/location-transparency",
          "/actor/behaviors",
          "/actor/stashing",
          "/actor/death-watch",
          "/actor/pipeto",
          "/actor/reentrancy",
          "/actor/passivation",
          "/actor/relocation",
          "/actor/singletons",
          "/actor/routers",
          "/actor/scheduling",
          "/actor/testkit"
        ],
        "icon": "users"
      },
      {
        "group": "Grains",
        "pages": [
          "/grains/overview",
          "/grains/reentrancy",
          "/grains/pipeto",
          "/grains/timers"
        ],
        "icon": "box"
      },
      {
        "group": "Remoting",
        "pages": ["/advanced/remoting", "/advanced/serialization"],
        "icon": "radio"
      },
      {
        "group": "Cluster",
        "pages": [
          "/clustering/overview",
          "/clustering/placement",
          "/clustering/multi-datacenter",
          "/clustering/service-discovery",
          "/clustering/partition-hashing",
          {
            "group": "Reliable Delivery",
            "pages": [
              "/clustering/reliable-delivery/point-to-point",
              "/clustering/reliable-delivery/work-pulling"
            ]
          }
        ],
        "icon": "network"
      },
      {
        "group": "Observability",
        "pages": ["/advanced/observability", "/advanced/event-streams"],
        "icon": "activity"
      },
      {
        "group": "Advanced",
        "pages": [
          "/advanced/client",
          "/advanced/extensions-and-dependencies",
          "/advanced/pubsub",
          "/advanced/distributed-data",
          "/advanced/streams",
          "/advanced/coordinated-shutdown"
        ],
        "icon": "zap"
      },
      {
        "group": "Architecture",
        "pages": [
          "/architecture/overview",
          "/architecture/code-map",
          "/architecture/design-decisions",
          "/architecture/dispatcher-pool",
          "/architecture/context-pools"
        ],
        "icon": "blocks"
      },
      {
        "group": "Contribution",
        "pages": [
          "/contributing/overview",
          "/contributing/development-setup",
          "/contributing/testing-strategy",
          "/contributing/extending"
        ],
        "icon": "hand-heart"
      },
      {
        "group": "Reference",
        "pages": [
          "/reference/interfaces",
          "/reference/v400-changes",
          "/reference/glossary"
        ],
        "icon": "book"
      },
      {
        "group": "Meta Framework",
        "pages": ["/meta-framework/ego"],
        "icon": "layers"
      }
    ]
  },
  "icons": { "library": "lucide" }
}
