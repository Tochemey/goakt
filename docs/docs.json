            ]
          },
          {
            "group": "Runtime",
            "icon": "settings",
            "pages": [
              "/advanced/client",
              "/advanced/extensions-and-dependencies",
              "/advanced/coordinated-shutdown"
            ]
          },
          {
            "group": "Observability",
            "icon": "activity",
            "pages": ["/advanced/observability", "/advanced/event-streams"]
          }
        ]
      },
      {
        "tab": "Architecture",
        "icon": "blocks",
        "groups": [
          {
            "group": "Architecture",
            "icon": "blocks",
            "pages": [
              "/architecture/overview",
              "/architecture/code-map",
              "/architecture/design-decisions",
              "/architecture/dispatcher-pool",
              "/architecture/context-pools"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "book",
        "groups": [
          {
            "group": "Reference",
            "icon": "book",
            "pages": ["/reference/interfaces", "/reference/glossary"]
          }
        ]
      },
      {
        "tab": "eGo",
        "icon": "layers",
        "groups": [
          {
            "group": "Meta Framework",
            "icon": "layers",
            "pages": ["/meta-framework/ego"]
          }
        ]
      },
      {
        "tab": "Contributing",
        "icon": "hand-heart",
        "groups": [
          {
            "group": "Contributing",
            "icon": "hand-heart",
            "pages": [
              "/contributing/overview",
              "/contributing/development-setup",
              "/contributing/testing-strategy",
              "/contributing/extending"
            ]
          }
        ]
      }
    ]
  },
  "footer": { "socials": { "github": "https://github.com/tochemey/goakt" } }
}
