{
  "$schema": "https://mintlify.com/docs.json",
  "name": "GoAkt",
  "description": "Distributed actor framework for Go, inspired by Erlang and Akka. Build reactive and distributed systems with typed actor messages.",
  "theme": "aspen",
  "seo": { "metatags": { "canonical": "https://docs.goakt.dev" } },
  "colors": { "primary": "#2563EB", "light": "#3B82F6", "dark": "#1D4ED8" },
  "favicon": "/assets/goakt-icon.png",
  "icons": { "library": "lucide" },
  "appearance": { "default": "system" },
  "fonts": {
    "heading": { "family": "Geist" },
    "body": { "family": "Geist" }
  },
  "logo": {
    "light": "/assets/goakt-logo-light.svg",
    "dark": "/assets/goakt-logo-dark.svg",
    "href": "https://docs.goakt.dev"
  },
  "background": { "decoration": "gradient" },
  "navbar": {
    "links": [
      {
        "label": "Migration from v3.x",
        "href": "/getting-started/migration-v3"
      },
      {
        "label": "API",
        "href": "https://pkg.go.dev/github.com/tochemey/goakt/v4"
      },
      { "label": "GitHub", "href": "https://github.com/tochemey/goakt" },
      {
        "label": "Install",
        "href": "/getting-started/installation",
        "icon": "download",
        "primary": true
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "claude", "mcp", "vscode"]
  },
  "styling": {
    "codeblocks": { "theme": { "light": "github-light", "dark": "dracula" } }
  },
  "redirects": [
    {
      "source": "/clustering/standalone",
      "destination": "/clustering/overview"
    },
    {
      "source": "/clustering/clustered",
      "destination": "/clustering/overview"
    },
    {
      "source": "/advanced/reliable-delivery",
      "destination": "/clustering/reliable-delivery/point-to-point"
    },
    {
      "source": "/architecture/context-pool",
      "destination": "/architecture/context-pools"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "icon": "rocket",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "/index",
              "/getting-started/installation",
              "/actor/first-actor"
            ]
          },
          {
            "group": "Upgrading",
            "icon": "arrow-up",
            "pages": [
              "/getting-started/migration-v3",
              "/reference/v400-changes"
            ]
          }
        ]
      },
      {
        "tab": "Actors",
        "icon": "users",
        "groups": [
          {
            "group": "Core Concepts",
            "icon": "circle-dot",
            "pages": [
              "/actor/actor-model",
              "/actor/actor-system",
              "/actor/pid",
              "/actor/lifecycle"
            ]
          },
          {
            "group": "Messaging",
            "icon": "send",
            "pages": [
              "/actor/messaging",
              "/actor/mailboxes",
              "/actor/pipeto",
              "/actor/stashing",
              "/actor/reentrancy",
              "/actor/scheduling"
            ]
          },
          {
            "group": "Fault Tolerance",
            "icon": "shield",
            "pages": [
              "/actor/supervision",
              "/actor/death-watch",
              "/actor/behaviors"
            ]
          },
          {
            "group": "Scaling & Placement",
            "icon": "move",
            "pages": [
              "/actor/location-transparency",
              "/actor/passivation",
              "/actor/relocation",
              "/actor/singletons",
              "/actor/routers"
            ]
          },
          {
            "group": "Testing",
            "icon": "flask-conical",
            "pages": ["/actor/testkit"]
          }
        ]
      },
      {
        "tab": "Grains",
        "icon": "box",
        "groups": [
          {
            "group": "Grains",
            "icon": "box",
            "pages": [
              "/grains/overview",
              "/grains/reentrancy",
              "/grains/pipeto",
              "/grains/timers"
            ]
          }
        ]
      },
      {
