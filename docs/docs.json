{
  "$schema": "https://mintlify.com/docs.json",
  "name": "GoAkt",
  "description": "Distributed actor framework for Go, inspired by Erlang and Akka. Build reactive and distributed systems with typed actor messages.",
  "theme": "aspen",
  "seo": {
    "metatags": {
      "canonical": "https://docs.goakt.dev"
    }
  },
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "favicon": "/assets/goakt-icon.svg",
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "dark"
  },
  "logo": {
    "light": "/assets/goakt-wordmark-light.svg",
    "dark": "/assets/goakt-wordmark-dark.svg",
    "href": "https://goakt.dev"
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "API Reference",
        "href": "https://pkg.go.dev/github.com/tochemey/goakt/v4",
        "icon": "package"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/tochemey/goakt",
        "icon": "github"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "mcp",
      "vscode"
    ]
  },
  "styling": {
    "codeblocks": {
      "theme": "night-owl"
    }
  },
  "redirects": [
    {
      "source": "/actor/first-actor",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/getting-started/installation",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/getting-started/production-usage",
      "destination": "https://goakt.dev/#production"
    },
    {
      "source": "/getting-started/use-cases",
      "destination": "https://goakt.dev"
    },
    {
      "source": "/getting-started/migration-v3",
      "destination": "/reference/v400-changes"
    },
    {
      "source": "/clustering/standalone",
      "destination": "/clustering/overview"
    },
    {
      "source": "/clustering/clustered",
      "destination": "/clustering/overview"
    },
    {
      "source": "/advanced/reliable-delivery",
      "destination": "/clustering/reliable-delivery/point-to-point"
    },
    {
      "source": "/architecture/context-pool",
      "destination": "/architecture/context-pools"
    }
  ],
